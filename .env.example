# ==============================================================================
# Variables d'Environnement - ASCOS Backend
# ==============================================================================

# Port d'écoute du serveur (par défaut 3000, ou injecté automatiquement par Render/Railway)
PORT=3000

# Mode d'exécution (development ou production)
NODE_ENV=production

# Clé secrète pour la signature des tokens JWT d'authentification
JWT_SECRET=ascos_natation_super_secret_jwt_key_2026_change_in_production

# Origines CORS autorisées (* pour toutes ou https://votre-app.com)
CORS_ORIGIN=*
